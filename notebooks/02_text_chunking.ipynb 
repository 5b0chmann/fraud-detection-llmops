{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPe/blgMDP0RH68khoGAgdZ"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["# 02 Text Chunking\n","\n","## Objective\n","\n","This notebook splits extracted documents into smaller text chunks for embedding generation.\n","\n","## Goals\n","\n","- Load extracted document text\n","- Split documents into chunks\n","- Analyze chunk statistics\n","- Prepare data for embeddings\n","\n","## Use Case\n","\n","Fraud Detection Knowledge Assistant"],"metadata":{"id":"8evlp9aYI243"}},{"cell_type":"code","execution_count":8,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Zf7t-uv6ItX7","executionInfo":{"status":"ok","timestamp":1787566294229,"user_tz":-120,"elapsed":5191,"user":{"displayName":"Sebastian Bochmann","userId":"18176961591438160910"}},"outputId":"75471113-7cf3-42b2-94a3-ec137b639646"},"outputs":[{"output_type":"stream","name":"stdout","text":["Raw data directory:\n","/content/drive/MyDrive/fraud-detection-llmops/data/raw\n","Total chunks: 88\n","Average chunk length: 995\n"]}],"source":["import pandas as pd\n","from pathlib import Path\n","from pypdf import PdfReader\n","\n","# Configure Data Directory\n","RAW_DATA_DIR = Path(\"data/raw\")\n","print(\"Raw data directory:\")\n","print(RAW_DATA_DIR.resolve())\n","\n","# PDF Text Extraction Function\n","def extract_pdf_text(pdf_path):\n","  reader = PdfReader(pdf_path)\n","  text = \"\"\n","  for page in reader.pages:\n","    page_text = page.extract_text()\n","    if page_text:\n","      text += page_text + \"\\n\"\n","  return text\n","\n","# Load Documents\n","pdf_files = list(RAW_DATA_DIR.glob(\"*.pdf\"))\n","documents = []\n","for pdf_file in pdf_files:\n","  text = extract_pdf_text(pdf_file)\n","  documents.append({\"file_name\": pdf_file.name, \"text\": text})\n","documents_df = pd.DataFrame(documents)\n","documents_df.head()\n","\n","# Text Chunking Function\n","def create_chunks(text, chunk_size=1000):\n","  chunks = []\n","  for i in range(0, len(text), chunk_size):\n","    chunk = text[i:i + chunk_size]\n","    chunks.append(chunk)\n","  return chunks\n","\n","# Create Chunks\n","chunk_records = []\n","for _, row in documents_df.iterrows():\n","  chunks = create_chunks(row[\"text\"])\n","  for idx, chunk in enumerate(chunks):\n","    chunk_records.append({\"file_name\": row[\"file_name\"],\n","                         \"chunk_id\": idx,\n","                         \"chunk_text\": chunk})\n","chunks_df = pd.DataFrame(chunk_records)\n","chunks_df.head()\n","\n","# Analyze Chunks\n","chunks_df[\"characters\"] = (chunks_df[\"chunk_text\"].str.len())\n","chunks_df[[\"file_name\", \"chunk_id\", \"characters\"]].head()\n","\n","# Chunk Statistics\n","print(f\"Total chunks: {len(chunks_df)}\")\n","print(f\"Average chunk length: {chunks_df['characters'].mean():.0f}\")"]},{"cell_type":"markdown","source":["## Conclusion\n","\n","Documents were successfully divided into smaller text chunks.\n","\n","The generated chunks will be used in the next notebook to create embeddings for vector search."],"metadata":{"id":"pCsWWFm_Mcy5"}}]}